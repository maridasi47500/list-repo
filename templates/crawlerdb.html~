{% extends 'base.html' %}
{% block montitre %}
{{ repo }} de {{ username }}
{% endblock %}

{% block content %}
<a href="/?username={{username }}&pageno={{ pageno }}">back to page {{ pageno }}</a>
<h2>readme {{ repo }} de {{ username }}</h2>
<a target="_blank" href="https://github.com/{{ username }}/{{ repo }}">accéder au repository</a>
<p>
<a target="_blank" href="/crawlerdescription?username={{ username }}&repo={{ repo }}&pageno={{ pageno }}">ajouter une README de description à {{ repo }}</a>

</p>
<p>
to clone this repository disconnect server : 

<code>
<input readonly="readonly" value="(cd .. && git clone git@github.com:{{ username }}/{{ repo }}.git)" style="width:300px;"/>
</code>
</p>
<p>
 to push the database of this repository disconnect server
<code>
<input readonly="readonly" value=". pleasecopynow{{ repo }}.sh" style="width:300px;"/>
</code>
</p>
<p>
 tout en 1 (clone this repository and push the database of this repository
<code>
<input readonly="readonly" value="(cd .. && git clone git@github.com:{{ username }}/{{ repo }}.git) && . pleasecopynow{{ repo }}.sh" style="width:300px;"/>
</code>
</p>
<textarea style="height:200px;width:100%;" readonly=true>
{{readme}}
</textarea>
<div class="row row-cols-1 row-cols-md-3 g-4">
	{%for x in schema%}
  <div class="col">
    <div class="card h-100">
      <div class="card-body">
	      <h5 class="card-title">&#9992; table "{{x}}"</h5>
	      {%for y in schema[x]%}
	      <p class="card-text myrow" onclick="nomdescolonnes.innerHTML=nomdescolonnes.innerHTML+'\nce que je pourrais faire avec la colonne {{y}} {{schema[x][y]}}\nce que je pourrais faire avec la table {{x}}';return false;"> {{y}} {{schema[x][y]}}</p>
  {%endfor%}
 </p>
      </div>
    </div>
  </div>
  {%endfor%}
</div>
<p>
select one get bootstrap item in my awesomelist
<select>
	{%for x in myawesomelist%}
	<option value="{{x[1]}}">{{x[0]}}</option>

  {%endfor%}
	</select>
</p>
<form method="post">
<div class="field">
<label>texte a ajouter</label>
<textarea style="height:200px;width:100%;" id="nomdescolonnes" name="finmot" placeholder="fin de mes mots"> 
</textarea>
</div>
<input value="send" type="submit"/>
</form>

{% endblock %}
